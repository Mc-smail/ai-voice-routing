    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet text = '';\n\nif (input.output?.[0]?.content?.[0]?.text) {\n  text = input.output[0].content[0].text;\n} else if (input.output_text) {\n  text = input.output_text;\n} else if (input.text) {\n  text = input.text;\n} else {\n  text = JSON.stringify(input);\n}\n\ntext = String(text).replace(/```json/gi, '').replace(/```/g, '').trim();\n\n// Read balanced JSON objects so trailing prose, quoted braces and escaped\n// quotes do not swallow the result. Multiple candidate results are ambiguous.\nfunction extractObject(source) {\n  const candidates = [];\n  let start = -1, depth = 0, quoted = false, escaped = false;\n  for (let index = 0; index < source.length; index++) {\n    const character = source[index];\n    if (start < 0) {\n      if (character === '{') { start = index; depth = 1; quoted = false; escaped = false; }\n      continue;\n    }\n    if (quoted) {\n      if (escaped) escaped = false;\n      else if (character === '\\\\') escaped = true;\n      else if (character === '\"') quoted = false;\n      continue;\n    }\n    if (character === '\"') quoted = true;\n    else if (character === '{') depth++;\n    else if (character === '}' && --depth === 0) {\n      try {\n        const value = JSON.parse(source.slice(start, index + 1));\n        if (value && typeof value === 'object' && !Array.isArray(value) && Object.hasOwn(value, 'kategorie')) candidates.push(value);\n      } catch {}\n      start = -1;\n    }\n  }\n  return candidates.length === 1 ? candidates[0] : {};\n}\nlet parsed = {};\ntry { parsed = JSON.parse(text); }\ncatch { parsed = extractObject(text); }\n\nif (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) parsed = {};\n\nconst original = String($node['Webhook'].json.body?.transcript || $node['Webhook'].json.transcript || input.transcript || '').toLowerCase();\nconst normalizeLabel = value => typeof value === 'string' ? value.trim().toLowerCase() : '';\nlet kategorie = normalizeLabel(parsed.kategorie);\n\n// Strong keyword routing has priority over AI category.\nif (/(termin|vereinbaren|kalender|uhrzeit|datum|rückruf|ruckruf|anruf|appointment)/i.test(original)) {\n  kategorie = 'termin';\n} else if (/(technik|technisch|router|internet|gerät|geraet|software|hardware|fehler|problem|störung|stoerung|defekt)/i.test(original)) {\n  kategorie = 'technik';\n} else if (/(?<![\\p{L}\\p{N}_])(?:bewerbung(?:en)?|bewerben|jobs?|jobangebote?|stelle|stellen|stellenangebote?|stellenanzeigen?|lebenslauf|praktikum|hr|personal(?:abteilung)?|arbeit)(?![\\p{L}\\p{N}_])/iu.test(original)) {\n  kategorie = 'bewerbung';\n} else if (/(preis|angebot|kaufen|produkt|beratung|verkauf|vertrieb|kosten|bestellen)/i.test(original)) {\n  kategorie = 'vertrieb';\n} else if (!['technik','termin','bewerbung','vertrieb','support'].includes(kategorie)) {\n  kategorie = 'support';\n}\n\nconst priority = normalizeLabel(parsed.prioritaet);\nconst prioritaet = ['niedrig', 'mittel', 'hoch'].includes(priority) ? priority : 'mittel';\nconst anliegen = typeof parsed.anliegen === 'string'\n  ? Array.from(parsed.anliegen.trim()).slice(0, 500).join('')\n  : '';\n\n// Routing is the only action the workflow implements.\nreturn [{ json: { kategorie, anliegen, prioritaet, aktion: 'weiterleiten' } }];"
      },
