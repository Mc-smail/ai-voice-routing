    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst now = new Date();\nconst parts = Object.fromEntries(new Intl.DateTimeFormat('en-GB', {\n  timeZone: 'Europe/Berlin', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23'\n}).formatToParts(now).map(part => [part.type, part.value]));\nreturn [{json: {...input, current_datetime_utc: now.toISOString(),\n  current_day: {Sun:0,Mon:1,Tue:2,Wed:3,Thu:4,Fri:5,Sat:6}[parts.weekday],\n  current_hour: Number(parts.hour), current_minute: Number(parts.minute),\n  current_minutes: Number(parts.hour) * 60 + Number(parts.minute), timezone: 'Europe/Berlin'\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -528,
        352
      ],
      "name": "Date & Time Berlin",
      "id": "a00d0089-6746-53cc-a0d4-b95e7e06a89f"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst transcript = input.body && Object.hasOwn(input.body, 'transcript')\n  ? input.body.transcript\n  : input.transcript;\n\nconst validTranscript = typeof transcript === 'string'\n  && transcript.length <= 8000\n  && transcript.trim().length > 0;\n\nreturn [{ json: { ...input, validTranscript } }];\n"
      },
