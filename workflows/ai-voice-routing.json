        "respondWith": "json",
        "responseBody": "={\n  \"message\": \"Ich verbinde Sie jetzt mit dem Technik Team.\",\n  \"department\": \"technik\",\n  \"agent_name\": \"Technik Team\",\n  \"transfer_target\": \"technik_agent\"\n}",
