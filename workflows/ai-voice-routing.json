    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\n\n// Öffnungszeiten: Montag-Freitag 09:00-18:00, Wochenende geschlossen\nconst day = input.current_day;\nconst currentMinutes = input.current_minutes;\nconst openMinutes = 9 * 60;\nconst closeMinutes = 18 * 60;\n\nconst isOpen = day >= 1 && day <= 5 && currentMinutes >= openMinutes && currentMinutes < closeMinutes;\n\nreturn [{\n  json: {\n    ...input,\n    transcript: Object.hasOwn(body, 'transcript') ? body.transcript : input.transcript,\n    isOpen,\n    opening_hours: 'Montag bis Freitag von 09:00 bis 18:00 Uhr. Samstag und Sonntag geschlossen.',\n    closed_message: 'Vielen Dank für Ihre Nachricht. Wir haben aktuell geschlossen. Unsere Öffnungszeiten sind Montag bis Freitag von 09:00 bis 18:00 Uhr. Bitte kontaktieren Sie uns während der Öffnungszeiten erneut.'\n  }\n}];"
      },
